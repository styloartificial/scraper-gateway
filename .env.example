# Salin file ini menjadi .env lalu isi dengan nilai asli.
# JANGAN PERNAH commit file .env ke git.

# Port tempat server berjalan
PORT=3001

# Secret key untuk autentikasi request dari Laravel (header: x-secret-key)
SECRET_KEY=ganti_dengan_secret_key_yang_kuat

# Base URL API pencari produk Lazada (dipisah dari kode supaya gampang ganti provider)
LAZADA_SEARCH_URL=https://lazada-scraper.omkar.cloud/lazada/catalog/search
